# Environment Variables Configuration
# Copy this file to .env and fill in your values

# ============================================
# Cloudinary CDN Configuration (Optional)
# ============================================
# Get your Cloud Name from https://cloudinary.com/console
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# If not set, images will be served from local /images folder
# To enable CDN:
# 1. Sign up at https://cloudinary.com (free tier available)
# 2. Upload your images to Cloudinary (mirror the /images folder structure)
# 3. Set VITE_CLOUDINARY_CLOUD_NAME in your .env file
# 4. Restart dev server

# ============================================
# Sentry Error Tracking (Optional)
# ============================================
# Get your DSN from https://sentry.io/settings/projects/
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id
# If not set, errors will only be logged to console
# To enable Sentry:
# 1. Sign up at https://sentry.io (free tier available)
# 2. Create a new project
# 3. Copy the DSN and set VITE_SENTRY_DSN in your .env file
# 4. Restart dev server

# ============================================
# Debug Mode (Optional)
# ============================================
# Enable debug logging in production
# VITE_DEBUG=false
# Set to 'true' to enable verbose logging in production
# Default: false (only errors logged in production)

# ============================================
# Supabase (F1 season snapshots — optional)
# ============================================
# Project URL and anon key: Supabase Dashboard → Project Settings → API
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# Service role (server/scripts only — never expose in the browser):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Apply schema: supabase/migrations/001_f1_snapshots.sql (or SQL editor)
# Push local JSON to DB: npm run sync:f1:supabase
# Season-tracker read order: /api/f1-db → /data/f1/ → /api/f1-season

# ============================================
# F1 historical snapshots (static JSON)
# ============================================
# Refresh after each race weekend or season end:
#   npm run sync:f1
#   npm run sync:f1:supabase   (after Supabase is configured)
# Commit updated JSON before deploy for instant loads when DB is cold.
# Live timing: /api/f1-live only.

# ============================================
# Production Build
# ============================================
# These are automatically set by Vite based on NODE_ENV
# NODE_ENV=production (set automatically during build)
# VITE_MODE=production (set automatically during build)
