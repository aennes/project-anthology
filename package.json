{
  "name": "project-anthology:-the-f1-narrative",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "predev": "npx --yes kill-port 3001 5173",
    "dev": "concurrently --kill-others --names \"api,vite\" -c \"cyan,green\" \"npm run dev:api\" \"npm run dev:vite:await\"",
    "dev:api": "tsx server/dev-api-server.ts",
    "dev:vite": "vite",
    "dev:vite:await": "npx --yes wait-on -t 30000 tcp:127.0.0.1:3001 && vite",
    "dev:e2e": "concurrently --kill-others -k \"npm run dev:api\" \"npm run dev:vite -- --port 5173 --strictPort\"",
    "fonts:season-tracker": "node scripts/copy-season-tracker-fonts.mjs",
    "sync:f1": "node scripts/sync-f1-snapshots.mjs",
    "sync:f1:seasons": "node scripts/sync-f1-snapshots.mjs --seasons-only",
    "sync:f1:supabase": "node scripts/sync-f1-to-supabase.mjs",
    "sync:f1:supabase:seasons": "node scripts/sync-f1-to-supabase.mjs --seasons-only",
    "build": "npm run images:gen && npm run images:optimize-story-38-40 && (npm run fonts:season-tracker || npm run nop) && vite build && node scripts/copy-season-tracker.mjs && node scripts/copy-tracks.mjs",
    "nop": "node -e \"process.exit(0)\"",
    "build:vercel": "(npm run images:gen || npm run nop) && (npm run images:circuit-images || npm run nop) && (npm run images:radio-anthology || npm run nop) && (npm run images:season-tracker || npm run nop) && (npm run images:optimize-story-38-40 || npm run nop) && (npm run fonts:season-tracker || npm run nop) && vite build && node scripts/copy-season-tracker.mjs && node scripts/copy-tracks.mjs",
    "build:check": "npm run build && node scripts/check-bundle-size.js",
    "preview": "vite preview",
    "images:gen": "node scripts/generate-responsive-images.js",
    "images:circuit-covers": "node scripts/fetch-circuit-cover-rasters.mjs",
    "images:circuit-images": "node scripts/fetch-circuit-images.mjs",
    "images:radio-anthology": "node scripts/fetch-radio-anthology-images.mjs",
    "images:season-tracker": "node scripts/fetch-season-tracker-images.mjs",
    "images:optimize-story-38-40": "node scripts/optimize-story-images-38-40.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:bundle": "node scripts/check-bundle-size.js",
    "vercel:link": "npx vercel link --yes --project project-anthology",
    "vercel:deploy": "npm run vercel:link && npx vercel deploy --prod --yes",
    "seed:assets": "node --env-file=.env.local --import=tsx/esm scripts/seed-assets.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@sentry/react": "^10.38.0",
    "@supabase/supabase-js": "^2.106.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.2.0",
    "dompurify": "^3.3.1",
    "framer-motion": "^12.23.24",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.3",
    "replicate": "^1.4.0",
    "sharp": "^0.34.5"
  },
  "optionalDependencies": {
    "cloudinary": "^1.41.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.7.13",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.47",
    "svgo": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
